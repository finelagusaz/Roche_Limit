# Files excluded when creating the .nar (gitignore syntax).
# Used by SSP and by build-nar.ps1 of ukagaka-developer. .updateignore includes this file.
# https://ssp.shillest.net/ukadoc/manual/descript_install.html
#
# .github/, .gitignore and .gitattributes are shipped on purpose, so that a ghost
# made from the installed folder can be put on GitHub with the same checks and releases.

# files for developing the ghost with ukagaka-developer (not shipped in the nar or in network updates)
/AGENTS.md
/CLAUDE.md
/GHOST.md
/.mcp.json
/.claude/
/.agents/
/build/

# files of the repository (git, editor, GitHub); the nar does not need them
/.github/
/.gitignore
/.gitattributes
/.editorconfig
/.narignore
/.updateignore

# balloon images of sstp.ps1 -Balloon, left only when the script was stopped midway
/ghost/master/devkit-balloon-*/

# git metadata (ghost/master/dic/system is a plain folder in the nar, not a submodule)
.git
.gitmodules

# needed only by network updates (.updateignore includes it again)
/delete.txt

# network update files
updates2.dau
updates.txt

# runtime data
profile/
yaya_variable.cfg

# Roche_Limit: GitHub 用・作業用のファイル
/README.md
/.superpowers/

# Roche_Limit: 開発キット一式は配布物に含めない（DEVKIT-GUIDE.md「配布物（nar）に開発キットを含めるかどうか」）
/AGENTS.md
/CLAUDE.md
/DEVKIT-GUIDE.md
/GHOST.md
/docs/agents/
/.mcp.json
/.claude/
/.github/
/tools/

# carried over from tools/devkit.narignore of the old development kit
*.yaya-dic-new
/ghost/master/dic/system/.github/
/ghost/master/dic/system/.vscode/
/ghost/master/dic/system/.gitattributes
/ghost/master/dic/system/LICENSE
/ghost/master/dic/system/README.md
/ghost/master/system/.github/
/ghost/master/system/.vscode/
/ghost/master/system/.gitattributes
/ghost/master/system/LICENSE
/ghost/master/system/README.md
