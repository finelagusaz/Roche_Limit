//**** トランスレータ *******************************************************************

//---- OnTranslateイベント --------------------------------------------------------------
//     もっとも単純な例。語尾変え（「。」→「にゅ。」）。動かないようにコメントアウトしています。
//OnTranslate
//{
//	REPLACE(reference[0], "。", "にゅ。")
//}

OnTranslate
{
	reference[0] = sfcnv(reference[0])
	reference[0]

	//とりあえず最初のおまじない(一時変数にとりあえず代入)
	_text = reference[0]

	//テキストのみトランスレート+ウェイトコントロール
	//etc.dicに記述
	_text = TextOnlyTranslator(_text,'TextOnlyTranslatorFunc')

	//結果を返す為のもの。
	_text
}

//**** ランダムトーク *******************************************************************

//---- OnAiTalkイベント -----------------------------------------------------------------
OnAiTalk
{
	if RAND(100) < communicateratio
	{
		//---- communicateratio % の率で他ゴーストへ話しかけ
		StartCommunicate
	}
	else
	{
		if mikireflag == 0
		{
			//---- 通常のランダムトーク、ただしチェイン中はチェイントーク
			if CHAIN.IDName == "" {
				RandomTalk
			}
			else {
				ChainTalk
			}
		}
		else
		{
			//---- 見切れ中なので見切れ中のトークを行う
			MikireTalk
		}
	}
}

//---- ランダムトーク -------------------------------------------------------------------
RandomTalk
{
    TOSTR(EVAL(CHR(0x22)+RandomTalkEx()+CHR(0x22)))
}

// nonoverlap は候補の数が変わると一巡の履歴を捨てる。
// そのため、条件で増減するトーク（季節・深夜・シェル・旧トーク）は
// 候補に混ぜず、SelectTalkPool の確率で束ごと選んでから引く。
// それぞれの束は自分の nonoverlap の履歴を持つ。
RandomTalkEx
{
	_talk = ''
	case SelectTalkPool {
		when 'season' {
			_talk = SeasonTalk
		}
		when 'midnight' {
			_talk = MidnightTalk
		}
		when 'shell' {
			_talk = ShellTalk
		}
		when 'old' {
			_talk = NormalTalkOld
		}
	}
	if _talk == '' {
		_talk = BaseTalk
	}
	_talk
}

//----------------------------------------
// どの束からトークを引くかを決める
// 戻り値: 'base' / 'season' / 'midnight' / 'shell' / 'old'
// 出やすさは各束の本数に比例させる（全トークを 1 つの候補に混ぜていたころと同じ割合）
//----------------------------------------
SelectTalkPool
{
	_pools = ('season', 'midnight', 'shell', 'old')
	_sizes = (SeasonTalkCount, 0, ShellTalkCount, 0)
	if GetTimeSlot == '深夜' {
		_sizes[1] = ARRAYSIZE(aryMidnightTalk)
	}
	if flgTalkOld == 1 {
		_sizes[3] = ARRAYSIZE(aryNormalTalkOld)
	}

	_total = BaseTalkCount
	foreach _sizes; _size {
		_total += _size
	}

	_r = RAND(_total)
	_i = 0
	while _i < ARRAYSIZE(_pools) {
		if _r < _sizes[_i] {
			_pools[_i]
			return
		}
		_r -= _sizes[_i]
		_i++
	}
	'base'
}

BaseTalkCount
{
	ARRAYSIZE(aryNormalTalk) + ARRAYSIZE(aryWorldTalk) + ARRAYSIZE(aryKariuTalk) /
	+ ARRAYSIZE(aryExtremeWorldTalk) + ARRAYSIZE(aryTopicTalk)
}

SeasonTalkCount
{
	case GetSeasonSlot {
		when '春' {
			ARRAYSIZE(arySpringTalk)
		}
		when '夏' {
			ARRAYSIZE(arySummerTalk)
		}
		when '秋' {
			ARRAYSIZE(aryAutumnTalk)
		}
		when '冬' {
			ARRAYSIZE(aryWinterTalk)
		}
		others {
			0
		}
	}
}

ShellTalkCount
{
	if shellname == '竜姫 / Drachen Fürstin' {
		ARRAYSIZE(aryDrachenFurstinTalk)
	}
	else {
		ARRAYSIZE(aryExiceOnlyTalk) + ARRAYSIZE(aryMicroTalk)
	}
}

//----------------------------------------
// いつものランダムトーク（候補の数が変わらない束）
//----------------------------------------
BaseTalk : nonoverlap
{
	_talk_array = IARRAY
	_talk_array ,= aryNormalTalk
	_talk_array ,= aryWorldTalk
	_talk_array ,= aryKariuTalk
	_talk_array ,= aryExtremeWorldTalk
	_talk_array ,= aryTopicTalk
	parallel _talk_array
}

//----------------------------------------
// 季節のトーク
//----------------------------------------
SeasonTalk
{
	case GetSeasonSlot {
		when '春' {
			SpringTalk
		}
		when '夏' {
			SummerTalk
		}
		when '秋' {
			AutumnTalk
		}
		when '冬' {
			WinterTalk
		}
	}
}

//----------------------------------------
// シェルごとのトーク
//----------------------------------------
ShellTalk
{
	if shellname == '竜姫 / Drachen Fürstin' {
		DrachenFurstinTalk
	}
	elseif RAND(ARRAYSIZE(aryExiceOnlyTalk) + ARRAYSIZE(aryMicroTalk)) < ARRAYSIZE(aryMicroTalk) {
		// ミクロ専用（ミクロの決死圏のときだけ中身がある）とイクサイス専用を、本数の比で選ぶ
		_talk = MicroTalk
		if _talk == '' {
			_talk = ExiceOnlyTalk
		}
		_talk
	}
	else {
		ExiceOnlyTalk
	}
}

//----------------------------------------
// 通常のランダムトーク
//----------------------------------------
NormalTalk : nonoverlap
{
	parallel aryNormalTalk
}

// ----------------------
// ミクロの決死圏専用トーク
//-----------------------
MicroTalk : nonoverlap {
	parallel aryMicroTalk
}


// ----------------------
// イクサイス専用トーク
//-----------------------
ExiceOnlyTalk : nonoverlap {
	parallel aryExiceOnlyTalk
}


// ----------------------
// 竜姫専用トーク
//-----------------------
DrachenFurstinTalk : nonoverlap {
	parallel aryDrachenFurstinTalk
}


// ----------------------
// 季節ごとのトーク群
//-----------------------
// 季節トーク：春
SpringTalk : nonoverlap {
	parallel arySpringTalk
}


// 季節トーク：夏
SummerTalk : nonoverlap {
	parallel arySummerTalk
}


// 季節トーク：秋
AutumnTalk : nonoverlap {
	parallel aryAutumnTalk
}


// 季節トーク：冬
WinterTalk : nonoverlap {
	parallel aryWinterTalk
}


// 深夜トーク
MidnightTalk : nonoverlap {
	parallel aryMidnightTalk
}



//**** 時報/重なり **********************************************************************

//---- OnMinuteChangeイベント -----------------------------------------------------------
OnMinuteChange
{
	//---- 時間の分を見て 0 であれば時報。それ以外のときは重なり処理を行う

	if minute == 0
	{
		//---- 分 = 0 だったので時報
		"\0\s[0]%hour12時です。"
		--
		//---- 特定の時間（正午など）ではさらに追加で話す
		if hour == 12
		{
			"\n\nお昼です。\n\w9食事はちゃんと摂らないと、\w4午後にばててしまいますよ。\w5\1\s[10]そうだね。"
		}
		elseif hour == 15
		{
			"\0\s[0]間食の時間ですね。\w9\n%usernameもお茶にしてみてはいかがでしょうか。\w9\n私は隅で邪魔にならないよう本を読んでますから\w9…\w4…。\w9\1\s[10]そういわずにお茶でも淹れて一緒に飲んだらどうだい。\w9"
		}
		--
		"\e"
	}
	elseif mikireflag == 1
	{
		//---- 分 != 0 、かつ見切れていたら見切れ中のトークを行う
		MikireTalk
	}
	elseif reference[2] == 1
	{
		//---- 分 != 0 、かつ見切れておらず本体とkeroが重なっていたら重なり処理
		//---- 大抵はkero側を引き離す処理を行う
		"\0\s[0]あの、重ならないでください。\1\s[10]っと、ごめんごめん。\w4\e"
	}
}


//**** 見切れ ***************************************************************************

//---- OnSecondChangeイベント -----------------------------------------------------------
OnSecondChange
{
	//---- 1 秒毎に実行される。ここではあまり重い処理を行わないこと
	//---- このテンプレートでは、見切れ処理のみ行っている

	if mikireflag == 1 && reference[1] == 0
	{
		//---- 見切れの終了
		EndMikireTalk
	}
	mikireflag = reference[1]
}

//---- 見切れ中 -------------------------------------------------------------------------
MikireTalk
{
	"\0\s[0]隅っこにいますね。\1\s[10]隅っこだね。\e"
}

//---- 見切れ終了 -----------------------------------------------------------------------
EndMikireTalk
{
	"\0\s[0]隅っこから戻りました。\1\s[10]だね。\e:chain=mikirego"
}

//---- 見切れ後の初回のランダムトークは見切れ関連のトークを行う。これをチェインで実現している ----
mikirego
{{CHAIN
	"\0\s[0]実のところ、隅は落ち着くので好きです。\w8\1\s[10]君はあれか、\w3猫か。\e"
}}CHAIN

//**** サーフィス復元 *******************************************************************

//---- OnSurfaceRestoreイベント ---------------------------------------------------------
OnSurfaceRestore
{
	"\0\s[0]\1\s[10]\e"
}
